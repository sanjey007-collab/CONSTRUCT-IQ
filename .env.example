# ConstructIQ Environment Configuration Template
DATABASE_URL=sqlite:///./constructiq.db
# For PostgreSQL in Docker:
# DATABASE_URL=postgresql://postgres:constructiq_password_2026@localhost:5432/constructiq

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

SECRET_KEY=constructiq-supersecret-production-token-2026
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","*"]

# Default Autonomous Policy Limits (INR)
MAX_AUTONOMOUS_PROCUREMENT=25000.0
MAX_AUTONOMOUS_TRANSFER=50000.0
